{
  "name": "voltura-places",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "node scripts/dev-ui.mjs",
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && tsc --noEmit && node scripts/check-architecture.mjs && node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:api": "node scripts/test-api.mjs && node scripts/test-routes-api.mjs",
    "publish": "node scripts/publish.mjs",
    "publish:promo": "node scripts/publish-promo.mjs",
    "publish:promo:dry-run": "node scripts/publish-promo.mjs --dry-run",
    "format": "node scripts/format.mjs",
    "format:check": "node scripts/format.mjs --check",
    "test:auth": "node --test tests/auth-runtime.test.mjs",
    "dev:promo": "node scripts/serve-promo.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "exifr": "7.1.3",
    "idb": "8.0.4",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "1.5.3",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@playwright/test": "1.64.1",
    "@prettier/plugin-php": "0.26.0",
    "@resvg/resvg-js": "2.6.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "1.5.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "fake-indexeddb": "6.2.7",
    "miniflare": "5.20261023.2-beta",
    "oxfmt": "0.75.0",
    "prettier": "3.9.10",
    "sharp": "0.35.5",
    "sql-formatter": "15.9.0",
    "ssh2-sftp-client": "12.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@12.0.2",
  "overrides": {
    "minimatch": "11.0.1",
    "glob": "14.0.2"
  }
}
