{
  "name": "voltura-places",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5173",
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit && node scripts/check-docs.mjs",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:api": "node scripts/test-api.mjs",
    "publish": "node scripts/publish.mjs",
    "publish:promo": "node scripts/publish-promo.mjs",
    "publish:promo:dry-run": "node scripts/publish-promo.mjs --dry-run",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "idb": "8.0.4",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.6",
    "miniflare": "5.20261023.2-beta",
    "oxfmt": "0.75.0",
    "ssh2-sftp-client": "12.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "wrangler": "4.155.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@12.0.2"
}
