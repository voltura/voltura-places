# Copy to ignored .dev.vars only for local authentication testing.
# The default local app already supports offline saving and backups.
AUTH_ORIGIN=http://127.0.0.1:5174
ACCOUNTS_ENABLED=false
SITES_NATIVE_AUTH=false
